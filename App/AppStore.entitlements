<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The App Store requires the sandbox. Quadra needs nothing else from it: the App Store
         version has no network access (no update check) and asks for Accessibility through
         System Settings, like the other version. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
