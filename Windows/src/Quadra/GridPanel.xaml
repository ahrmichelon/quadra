<Window x:Class="Quadra.GridPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quadra"
        Title="Quadra"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="12">
  <Window.Resources>
    <!-- Colors. QuadraApp replaces them to follow light/dark mode and the accent color. -->
    <SolidColorBrush x:Key="PanelBackground" Color="#99F3F3F3" />
    <SolidColorBrush x:Key="PanelBorder" Color="#24000000" />
    <SolidColorBrush x:Key="PanelText" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="PanelSubtleText" Color="#B21A1A1A" />
    <SolidColorBrush x:Key="HoverFill" Color="#14000000" />
    <SolidColorBrush x:Key="PressedFill" Color="#24000000" />
    <SolidColorBrush x:Key="SegmentFill" Color="#0F000000" />
    <SolidColorBrush x:Key="AccentFill" Color="#FF3B62F4" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFFFF" />

    <!-- Flat round button with an icon or a symbol. -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource PanelSubtleText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverFill}" />
                <Setter Property="Foreground" Value="{DynamicResource PanelText}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource PressedFill}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small stepper button (− and +). -->
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource PanelText}" />
    </Style>

    <!-- One display in the display picker. -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource PanelText}" />
      <Setter Property="Background" Value="{DynamicResource SegmentFill}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="5" Padding="6,3">
              <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                         TextTrimming="CharacterEllipsis"
                         HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverFill}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFill}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PanelTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PanelText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border x:Name="Frame"
          Background="{DynamicResource PanelBackground}"
          BorderBrush="{DynamicResource PanelBorder}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="14,10,14,10">
    <StackPanel x:Name="Stack">
      <!-- Title and buttons -->
      <DockPanel Height="24">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE711;" />
        <Button x:Name="GearButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="0,0,2,0"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE713;" />
        <TextBlock x:Name="TitleText" Style="{StaticResource PanelTextStyle}" FontSize="13" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
      </DockPanel>

      <!-- Display picker (only with more than one display) -->
      <UniformGrid x:Name="DisplayPicker" Rows="1" Margin="-1,6,-1,0" />

      <!-- The grid -->
      <local:GridCanvas x:Name="Cells" Margin="0,8,0,0" />

      <!-- Columns and rows on the left, a hint on the right -->
      <DockPanel Margin="0,8,0,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ColumnsText" Style="{StaticResource PanelTextStyle}" FontSize="11" MinWidth="62" />
          <Button x:Name="FewerColumns" Style="{StaticResource StepButton}" Content="−" />
          <Button x:Name="MoreColumns" Style="{StaticResource StepButton}" Content="+" />
          <TextBlock x:Name="RowsText" Style="{StaticResource PanelTextStyle}" FontSize="11" MinWidth="52"
                     Margin="10,0,0,0" />
          <Button x:Name="FewerRows" Style="{StaticResource StepButton}" Content="−" />
          <Button x:Name="MoreRows" Style="{StaticResource StepButton}" Content="+" />
        </StackPanel>
        <TextBlock x:Name="HintText" Style="{StaticResource PanelTextStyle}" FontSize="11"
                   Foreground="{DynamicResource PanelSubtleText}" TextAlignment="Right"
                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
